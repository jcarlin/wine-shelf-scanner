# Google Cloud Vision API
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# LLM for OCR normalization
# USE_LITELLM enables unified interface with automatic fallbacks (default: true)
USE_LITELLM=true

# Choose primary provider: "gemini" (default), "claude", or "auto" (uses LiteLLM)
LLM_PROVIDER=gemini

# API keys - LiteLLM will use available keys for fallbacks
# At least one is required. Multiple keys enable automatic fallback.

# Get Gemini key from: https://aistudio.google.com/apikey (recommended - fastest/cheapest)
GOOGLE_API_KEY=your-gemini-api-key-here

# Get Claude key from: https://console.anthropic.com/settings/keys
# Required by the default `single_llm` pipeline (Haiku 4.5 by default).
ANTHROPIC_API_KEY=your-claude-api-key-here

# Get OpenAI key from: https://platform.openai.com/api-keys (additional fallback)
# OPENAI_API_KEY=your-openai-api-key-here

# Mock mode (set to "true" to use mock responses)
USE_MOCKS=true

# Debug mode (include pipeline stats in all scan responses)
# DEBUG_MODE=true

# Pipeline mode — `single_llm` is the new default (one multimodal LLM call per scan).
# Other modes (legacy / turbo / flash_names / hybrid / fast) still work but are
# slated for removal in Phase G of the single-LLM pivot.
PIPELINE_MODE=single_llm

# Multimodal model used by the single_llm pipeline. Defaults to Haiku 4.5
# (cheapest, fast vision). Any LiteLLM-supported multimodal model works.
# Examples (uncomment one):
#SINGLE_LLM_MODEL=anthropic/claude-haiku-4-5-20251001    # default — ~$0.006/scan
#SINGLE_LLM_MODEL=anthropic/claude-sonnet-4-6            # ~3× cost, stronger
#SINGLE_LLM_MODEL=anthropic/claude-opus-4-7              # strongest, much more expensive
#SINGLE_LLM_MODEL=gemini/gemini-2.5-pro

# LLM image budget. Tune only if you see truncation warnings or upload-size errors.
# LLM_IMAGE_MAX_DIM=2048
# LLM_IMAGE_QUALITY=85

# Feature flags (all default to true)
# FEATURE_WINE_MEMORY=false
# FEATURE_SHELF_RANKING=false
# FEATURE_SAFE_PICK=false
# FEATURE_PAIRINGS=false
# FEATURE_TRUST_SIGNALS=false
